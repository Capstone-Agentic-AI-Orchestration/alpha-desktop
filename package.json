{
  "name": "alpha-desktop",
  "version": "2.4.25",
  "description": "Alpha — AI work, orchestrated. Desktop application.",
  "main": "main.js",
  "author": "Alpha",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test:appearance": "node --test tests/appearance.test.cjs tests/appearance-bridge.test.cjs tests/appearance-main.test.cjs tests/appearance-prepare.test.cjs",
    "test:local-access": "node --test tests/local-access.test.cjs",
    "prepare:build": "node scripts/prepare.mjs",
    "start": "npm run prepare:build && electron .",
    "dist": "npm run prepare:build && electron-builder --win",
    "dist:portable": "npm run prepare:build && electron-builder --win portable",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "p-queue": "^8.1.0",
    "pg": "^8.23.0",
    "split2": "^4.2.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "alphaVendor": {
    "gh": {
      "version": "2.101.0",
      "sha256": "bc6c814367b193cd8e713611d61e36013c0ef843b8f516458fe3eda039192794"
    }
  },
  "build": {
    "appId": "com.alpha.desktop",
    "productName": "Alpha",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "startup-update.html",
      "startup-update-preload.js",
      "desktop-address.cjs",
      "appearance.cjs",
      "local-access.cjs",
      "local-preview-view.cjs",
      "assets/**/*",
      "build/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "vendor/gh",
        "to": "gh"
      }
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "assets/alpha-mark.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer.nsh",
      "createDesktopShortcut": true,
      "shortcutName": "Alpha",
      "artifactName": "Alpha-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Alpha-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Capstone-Agentic-AI-Orchestration",
      "repo": "alpha-desktop",
      "private": true,
      "releaseType": "release"
    }
  }
}
