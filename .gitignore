# Dependencies
node_modules/

# Staged payload — regenerated by `npm run prepare:build` from the sibling
# projects. Committing it would duplicate alpha-fe-main and alpha-be-main here
# and go stale the moment either one changes.
build/

# Packaged installers. ~450MB per build, and individual .exe files exceed
# GitHub's 100MB hard limit. Publish these as release assets, never as commits.
release/

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini
